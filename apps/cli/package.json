{
  "name": "@rooster/cli",
  "version": "1.9.0",
  "license": "AGPL-3.0-only",
  "description": "The rooster command line: tasks from your terminal, scripts and CI (docs/spec/07-cli.md).",
  "type": "module",
  "bin": {
    "rooster": "./dist/rooster.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "scripts/smoke.sh node dist/rooster.mjs",
    "binaries": "scripts/build-binaries.sh"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@rooster/api-client": "workspace:*",
    "@rooster/core": "workspace:*",
    "@rooster/i18n": "workspace:*",
    "@rooster/mcp": "workspace:*",
    "@rooster/tokens": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "citty": "catalog:",
    "ink": "catalog:",
    "ink-testing-library": "catalog:",
    "react": "catalog:",
    "smol-toml": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "rooster",
    "tasks",
    "todo",
    "cli"
  ],
  "optionalDependencies": {
    "@napi-rs/keyring": "catalog:"
  }
}
