{
  "name": "@rooster/server",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsdown",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "openapi:emit": "tsx src/scripts/emit-openapi.ts",
    "db:generate": "drizzle-kit generate && node scripts/strictify-migrations.mjs",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@better-auth/api-key": "catalog:",
    "@better-auth/cimd": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@react-email/render": "catalog:",
    "@rooster/api-client": "workspace:*",
    "@rooster/core": "workspace:*",
    "@rooster/i18n": "workspace:*",
    "@rooster/mcp": "workspace:*",
    "@rooster/tokens": "workspace:*",
    "@scalar/hono-api-reference": "catalog:",
    "better-auth": "catalog:",
    "better-sqlite3": "catalog:",
    "busboy": "catalog:",
    "croner": "catalog:",
    "drizzle-orm": "catalog:",
    "file-type": "catalog:",
    "hono": "catalog:",
    "nodemailer": "catalog:",
    "pino": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "catalog:",
    "web-push": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@scalar/api-reference": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/busboy": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/web-push": "catalog:",
    "drizzle-kit": "catalog:",
    "ical.js": "catalog:",
    "oauth2-mock-server": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
