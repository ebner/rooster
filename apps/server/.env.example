# rooster server configuration (docs/spec/08-operations.md §3).
# Every variable also accepts <NAME>_FILE: the value is then read from that file (Docker secrets).
# Invalid configuration makes the server print every problem and exit with code 78.

# --- Required -------------------------------------------------------------------------
# Public URL; used for OIDC callbacks, cookies, links and the CSRF origin check.
ROOSTER_BASE_URL=http://localhost:3000
# At least 32 random characters; placeholders and repeated patterns are refused.
# Generate with: openssl rand -base64 48
ROOSTER_AUTH_SECRET=
# Comma-separated; always allowed to sign in and instance admins.
ROOSTER_ADMIN_EMAILS=you@example.com

# --- Sign-in (required: Google and/or at least one OIDC provider) ------------------------
# The server exits with code 78 when no provider is configured.
# Redirect URI to register with a provider: <ROOSTER_BASE_URL>/api/auth/callback/<id>
# (Google: <ROOSTER_BASE_URL>/api/auth/callback/google).
# ROOSTER_GOOGLE_CLIENT_ID=
# ROOSTER_GOOGLE_CLIENT_SECRET=
# JSON array of {id, name, discoveryUrl, clientId, clientSecret, scopes?, trustEmail?}; scopes
# default to ["openid","email","profile"]. IDs are lowercase and unique ("google" is taken by
# Google). trustEmail (default false): the provider is authoritative for the email addresses
# it asserts (e.g. your company's own IdP), so its first sign-in may join an existing account
# with the same verified email. Leave it off for providers where users can claim any address;
# such a provider then cannot sign in to an account created through another provider.
# Google is always trusted.
# ROOSTER_OIDC_PROVIDERS=[]
# Extra allowed emails / domains (comma-separated), in addition to the admin UI allowlist.
# Without any allowlist only ROOSTER_ADMIN_EMAILS and invited people can sign in.
# ROOSTER_ALLOWED_EMAILS=
# ROOSTER_ALLOWED_DOMAINS=

# --- Local development with the mock IdP --------------------------------------------------
# 1. `pnpm dev:idp` starts a mock OIDC issuer at http://localhost:9400 (DEV_IDP_PORT).
#    Every sign-in succeeds as dev@example.com; switch identity with
#    curl -X POST localhost:9400/__next-user -H 'content-type: application/json' \
#         -d '{"email":"bob@example.com","name":"Bob"}'
# 2. Uncomment the lines below (they replace the values above). With `pnpm dev` the
#    browser talks to Vite, so the base URL (cookies, OAuth callback, CSRF origin) is
#    Vite's; Vite proxies /api to this server.
# ROOSTER_BASE_URL=http://localhost:5173
# ROOSTER_ADMIN_EMAILS=dev@example.com
# ROOSTER_OIDC_PROVIDERS=[{"id":"dev","name":"Dev login","discoveryUrl":"http://localhost:9400/.well-known/openid-configuration","clientId":"rooster-dev","clientSecret":"rooster-dev-secret"}]
# The IdP must be running when the server starts (discovery is fetched at boot).

# --- Runtime ----------------------------------------------------------------------------
# Database, attachments and backups. Must be a local filesystem (no NFS/SMB).
# For local development point it somewhere writable, e.g. ./data
ROOSTER_DATA_DIR=./data
# PORT=3000
# Directory with the web build (index.html, assets/). Default: <server dist>/../public.
# ROOSTER_WEB_DIR=
# Honour X-Forwarded-For / X-Forwarded-Proto; set behind a reverse proxy.
# ROOSTER_TRUST_PROXY=false
# How many trusted proxies append to X-Forwarded-For (e.g. 1 for Apache alone, 2 for a CDN in
# front of Apache). The client IP is that many entries from the right; anything further
# left is client-supplied and ignored.
# ROOSTER_TRUSTED_PROXY_HOPS=1
# fatal | error | warn | info | debug | trace | silent
# ROOSTER_LOG_LEVEL=info
# Shown in /api/v1/meta; set by the Docker build.
# ROOSTER_GIT_SHA=dev
# Test-only (AC-8.4, the e2e servers): check every /api/v1 response against the OpenAPI
# document and serve mismatches at /__test/response-violations. Never in production.
# ROOSTER_VALIDATE_RESPONSES=false

# --- Email (enables email features) ------------------------------------------------------
# Invite emails, notification emails (immediate or a 15-minute batch), the daily digest.
# Without it email options are hidden and invites are copy-the-link only.
# smtp:// (STARTTLS when offered) or smtps:// (TLS); the only host email is sent to.
# ROOSTER_SMTP_URL=smtps://user:pass@smtp.example.com:465
# Required when ROOSTER_SMTP_URL is set: an address, optionally as "Name <address>".
# ROOSTER_MAIL_FROM=Rooster <rooster@example.com>

# --- Web Push -------------------------------------------------------------------------------
# Without these, a key pair is generated at first boot and kept in the database
# (Admin → System → "Regenerate push keys" replaces it). Set both or neither:
# base64url P-256 keys, e.g. from `npx web-push generate-vapid-keys`. Env keys cannot be
# regenerated from the admin UI.
# ROOSTER_VAPID_PUBLIC=
# ROOSTER_VAPID_PRIVATE=
# The push services' contact for this server: a mailto: or https:// URL.
# Default: mailto:<first admin email>
# ROOSTER_VAPID_SUBJECT=

# --- Attachments --------------------------------------------------------------------------
# ROOSTER_UPLOAD_MAX_MB=25
# Setting the bucket switches attachment storage to S3.
# ROOSTER_S3_ENDPOINT=
# ROOSTER_S3_REGION=
# ROOSTER_S3_BUCKET=
# ROOSTER_S3_ACCESS_KEY_ID=
# ROOSTER_S3_SECRET_ACCESS_KEY=
# ROOSTER_S3_FORCE_PATH_STYLE=false

# --- Backups -------------------------------------------------------------------------------
# Cron pattern, or "off" to disable.
# ROOSTER_BACKUP_CRON=0 3 * * *
# ROOSTER_BACKUP_KEEP_DAILY=7
# ROOSTER_BACKUP_KEEP_WEEKLY=4

# --- Monitoring ----------------------------------------------------------------------------
# Enables /metrics (bearer-protected), at least 16 characters.
# ROOSTER_METRICS_TOKEN=

# Server timezone, used only for logs.
# TZ=UTC
