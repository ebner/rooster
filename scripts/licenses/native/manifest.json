      "constants-browserify@1.0.0",
      "os-browserify@0.3.0",
      "path-browserify@1.0.1",
      "stream-browserify@3.0.0",
      "timers-browserify@2.0.12",
      "tty-browserify@0.0.1",
      "url@0.11.4",
      "vm-browserify@1.1.2"
    ],
    "extraNote": "Listed in Bun's LICENSE.md but not in the polyfills' bun.lock (Bun keeps adapted copies in src/node-fallbacks); their files are taken from the latest npm release."
  },
